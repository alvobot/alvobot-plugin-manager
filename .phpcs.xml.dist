<?xml version="1.0"?>
<ruleset name="AlvoBot Plugin Manager">
	<description>PHPCS ruleset for the AlvoBot Plugin Manager WordPress plugin.</description>

	<!-- Scan these files -->
	<file>.</file>

	<!-- Exclude paths -->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>
	<exclude-pattern>*.min.js</exclude-pattern>
	<exclude-pattern>*.min.css</exclude-pattern>

	<!-- Only check PHP files -->
	<arg name="extensions" value="php"/>

	<!-- Show progress and colors -->
	<arg value="ps"/>
	<arg name="colors"/>
	<!-- Keep legacy warnings visible while failing the gate only on actionable errors. -->
	<config name="ignore_warnings_on_exit" value="1"/>

	<!-- Use WordPress Coding Standards -->
	<rule ref="WordPress">
		<!-- Allow short array syntax -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<!-- Keep PHPCS focused on correctness, security, escaping, sanitization, and compatibility. -->
		<exclude name="Squiz.Commenting"/>
		<exclude name="Generic.Commenting.DocComment.MissingShort"/>
		<exclude name="Generic.CodeAnalysis.UnusedFunctionParameter"/>
		<exclude name="Generic.CodeAnalysis.UselessOverridingMethod"/>
		<exclude name="Universal.Files.SeparateFunctionsFromOO.Mixed"/>
		<exclude name="WordPress.PHP.YodaConditions.NotYoda"/>
		<exclude name="WordPress.NamingConventions.ValidVariableName"/>
		<exclude name="WordPress.WP.I18n.MissingTranslatorsComment"/>
		<exclude name="WordPress.WP.I18n.MissingSingularPlaceholder"/>
		<exclude name="WordPress.WP.I18n.NonSingularStringLiteralText"/>
		<!-- Reduce noise from file naming (class names don't match WP conventions) -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
	</rule>

	<!-- PHP Compatibility - minimum PHP 7.4 -->
	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- WordPress-specific config -->
	<config name="minimum_wp_version" value="5.8"/>

	<!-- Text domain for i18n -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="alvobot-pro"/>
			</property>
		</properties>
	</rule>

</ruleset>
